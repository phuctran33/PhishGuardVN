import 'dart:convert';
import 'dart:io';
import 'package:integration_test/integration_test_driver.dart';

Future<void> main() async {
  final output = Platform.environment['QA_MLP_ANDROID_OUTPUT'];
  if (output == null || output.isEmpty) throw StateError('Set QA_MLP_ANDROID_OUTPUT');
  await integrationDriver(writeResponseOnFailure: true, responseDataCallback: (data) async {
    if (data == null) throw StateError('Missing Android Student MLP results');
    final file = File(output);
    file.parent.createSync(recursive: true);
    file.writeAsStringSync('${const JsonEncoder.withIndent('  ').convert(data)}\n');
  });
}
