!apps/
!apps/web/
!apps/web/pubspec.yaml
!apps/web/pubspec.lock
!apps/web/lib/
!apps/web/lib/**
!apps/web/assets/
!apps/web/assets/**
!apps/web/web/
!apps/web/web/**
**/__pycache__
