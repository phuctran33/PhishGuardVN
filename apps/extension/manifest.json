{
  "manifest_version": 3,
  "name": "PhishGuardVN",
  "version": "1.0.0",
  "description": "Kiểm tra đường dẫn đã chọn với PhishGuardVN trước khi mở.",
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://localhost/*", "https://*/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
